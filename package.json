  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "yarn clean && yarn build:types && yarn build:lib && yarn build:demo",
    "build:package": "rm -rf dist && yarn build:types && yarn build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "generate:dictionary": "uv run scripts/generate_ecdict.py",
    "generate:chinese-dictionaries": "uv run scripts/generate_chinese_dictionaries.py",
    "generate:examples": "uv run scripts/generate_oanc_examples.py",
    "generate:inflections": "uv run scripts/generate_ecdict_inflections.py",
    "generate:synonyms": "uv run scripts/generate_wordnet_synonyms.py",
    "generate:roots": "uv run scripts/generate_unimorph_roots.py",
    "test:chinese": "python3 scripts/test_generate_chinese_dictionaries.py",
    "test:examples": "python3 scripts/test_generate_oanc_examples.py",
    "test:inflections": "python3 scripts/test_generate_ecdict_inflections.py",
    "test:synonyms": "python3 scripts/test_generate_wordnet_synonyms.py",
    "test:roots": "python3 scripts/test_generate_unimorph_roots.py",
    "test:result-sources": "node scripts/test_english_result_sources.mjs",
    "test:chinese-suggestions": "node scripts/test_chinese_suggestions.mjs",
    "clean": "rm -rf dist demo-dist",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "yarn build:package",
    "check": "yarn test:chinese && yarn test:examples && yarn test:inflections && yarn test:synonyms && yarn test:roots && yarn test:result-sources && yarn test:chinese-suggestions && yarn format:check && yarn lint && yarn typecheck && yarn build"
  },
