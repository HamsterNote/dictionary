{
  "name": "@hamster-note/dictionary",
  "version": "0.0.0",
  "description": "仓鼠笔记的 React 词典悬浮窗组件",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vocabulary-packs/bnc": {
      "types": "./dist/vocabulary-packs/bnc.d.ts",
      "import": "./dist/vocabulary-packs/bnc.js"
    },
    "./vocabulary-packs/cet4": {
      "types": "./dist/vocabulary-packs/cet4.d.ts",
      "import": "./dist/vocabulary-packs/cet4.js"
    },
    "./vocabulary-packs/cet6": {
      "types": "./dist/vocabulary-packs/cet6.d.ts",
      "import": "./dist/vocabulary-packs/cet6.js"
    },
    "./vocabulary-packs/gre": {
      "types": "./dist/vocabulary-packs/gre.d.ts",
      "import": "./dist/vocabulary-packs/gre.js"
    },
    "./vocabulary-packs/gk": {
      "types": "./dist/vocabulary-packs/gk.d.ts",
      "import": "./dist/vocabulary-packs/gk.js"
    },
    "./vocabulary-packs/ielts": {
      "types": "./dist/vocabulary-packs/ielts.d.ts",
      "import": "./dist/vocabulary-packs/ielts.js"
    },
    "./vocabulary-packs/ky": {
      "types": "./dist/vocabulary-packs/ky.d.ts",
      "import": "./dist/vocabulary-packs/ky.js"
    },
    "./vocabulary-packs/toefl": {
      "types": "./dist/vocabulary-packs/toefl.d.ts",
      "import": "./dist/vocabulary-packs/toefl.js"
    },
    "./vocabulary-packs/zk": {
      "types": "./dist/vocabulary-packs/zk.d.ts",
      "import": "./dist/vocabulary-packs/zk.js"
    },
    "./style.css": {
      "types": "./dist/style.d.ts",
      "default": "./dist/dictionary.css"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "yarn clean && yarn build:types && yarn build:lib && yarn build:demo",
    "build:package": "rm -rf dist && yarn build:types && yarn build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "generate:dictionary": "uv run scripts/generate_ecdict.py",
    "clean": "rm -rf dist demo-dist",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "yarn build:package",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn build"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "@system-ui-js/multi-drag-core": "0.4.0",
    "loglevel": "1.9.2"
  },
  "dependencies": {
    "@hamster-note/components": "^0.3.0",
    "@system-ui-js/multi-drag": "0.4.0"
  }
}
